# Variables de entorno que lee el proyecto (plantilla sin valores reales).
# El código no carga .env automáticamente: define la variable en la terminal
#   PowerShell: $env:MLFLOW_TRACKING_URI = "http://127.0.0.1:5000"
#   bash:       export MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# Si guardas una copia local como .env, queda excluida por .gitignore: nunca subas
# credenciales, tokens ni URLs privadas al repositorio.

# Servidor de MLflow. Vacío o sin definir = SQLite local (mlflow.db en la raíz del proyecto).
MLFLOW_TRACKING_URI=
